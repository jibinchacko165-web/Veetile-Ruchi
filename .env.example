# ==============================================================================
# Veetile-Ruchi Environment Configuration Template
# ==============================================================================

# Django Core
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL / SQLite)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=veetile_ruchi
# DB_USER=root
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Map Configuration
# Primary Map Tile Provider (Default: Esri World Street Map — Authorized for Leaflet, no API key required, zero watermarks, no HTTP 403 blocks)
MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
MAP_TILE_ATTRIBUTION=Tiles &copy; Esri &mdash; Source: Esri, DeLorme, NAVTEQ, USGS, TomTom
MAP_TILE_SUBDOMAINS=abc

# Secondary Map Tile Provider Fallback (Esri World Topo Map)
MAP_TILE_FALLBACK_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}
MAP_TILE_FALLBACK_ATTRIBUTION=Tiles &copy; Esri &mdash; Source: Esri, DeLorme, NAVTEQ, TomTom

# Optional CARTO API Key:
# If you prefer CARTO Basemaps, provide a key from https://carto.com.
# If CARTO_API_KEY is omitted, the app uses Esri (avoiding CARTO's 'API KEY REQUIRED' watermark).
CARTO_API_KEY=

# Optional Google Maps API Key (Leaflet works out-of-the-box without requiring this key)
GOOGLE_MAPS_API_KEY=
