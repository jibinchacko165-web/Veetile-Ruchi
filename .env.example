# ==============================================================================
# VEETILE-RUCHI — PRODUCTION ENVIRONMENT CONFIGURATION (ZOHO CATALYST APPSAIL)
# ==============================================================================

# Core Django Settings
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Hostnames & Origins (Zoho AppSail subdomain or custom domain)
# Example: myapp.zohocatalystapps.com,veetileruchi.com
ALLOWED_HOSTS=.zohocatalystapps.com,.catalystserverless.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.zohocatalystapps.com,https://*.catalystserverless.com

# Database Configuration (PostgreSQL / Supabase / Cloud DB)
# Option A: Full Connection URL (Recommended for Supabase PostgreSQL)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Option B: Individual Database Parameters (Local development)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=veetile_ruchi
DB_USER=postgres
DB_PASSWORD=your_production_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Supabase Storage Configuration (Uploaded Media and Food Images)
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=your_supabase_service_role_or_anon_key
# SUPABASE_STORAGE_BUCKET=media
# USE_SUPABASE_STORAGE=False

# Zoho Mail SMTP Configuration
EMAIL_HOST=smtppro.zoho.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your_zoho_app_specific_password
DEFAULT_FROM_EMAIL=Veetile Ruchi <noreply@yourdomain.com>

# Razorpay Payment Gateway Configuration
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Security & SSL
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Concurrency & Gunicorn
WEB_CONCURRENCY=3
PYTHON_MAX_THREADS=2
GUNICORN_TIMEOUT=120
LOG_LEVEL=info
