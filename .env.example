# ==============================================================================
# VEETILE-RUCHI — PRODUCTION ENVIRONMENT CONFIGURATION (ZOHO CATALYST APPSAIL)
# ==============================================================================

# Core Django Settings
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Hostnames & Origins (Zoho AppSail subdomain or custom domain)
# Example: myapp.zohocatalystapps.com,veetileruchi.com
ALLOWED_HOSTS=.zohocatalystapps.com,.catalystserverless.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.zohocatalystapps.com,https://*.catalystserverless.com

# Database Configuration (PostgreSQL / Cloud DB)
# Option A: Full Connection URL (Recommended for cloud databases like Supabase, Neon, AWS RDS, Zoho Catalyst DB)
# DATABASE_URL=postgresql://username:password@hostname:5432/veetile_ruchi?sslmode=require

# Option B: Individual Database Parameters
DB_ENGINE=django.db.backends.postgresql
DB_NAME=veetile_ruchi
DB_USER=postgres
DB_PASSWORD=your_production_db_password
DB_HOST=your_db_host_here
DB_PORT=5432

# Zoho Mail SMTP Configuration
EMAIL_HOST=smtppro.zoho.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your_zoho_app_specific_password
DEFAULT_FROM_EMAIL=Veetile Ruchi <noreply@yourdomain.com>

# Security & SSL
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Concurrency & Gunicorn
WEB_CONCURRENCY=3
PYTHON_MAX_THREADS=2
GUNICORN_TIMEOUT=120
LOG_LEVEL=info
